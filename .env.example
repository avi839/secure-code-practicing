# SecureReflex AI - environment configuration template
# Copy to .env (repository root) and adjust. Every setting is optional; the defaults
# below match backend/app/config.py. Never commit a .env that contains real API keys.

# ============================================================================
# ENVIRONMENT
# ============================================================================
# development | production | test
ENVIRONMENT=development
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO

# ============================================================================
# DATABASE
# ============================================================================
# Default: SQLite file at backend/data/securereflex.db (created automatically).
# Relative sqlite paths are resolved against the backend/ directory.
# DATABASE_URL=sqlite+aiosqlite:///./data/securereflex.db
# PostgreSQL (requires asyncpg, included in requirements.txt):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securereflex

# ============================================================================
# AI PROVIDERS
# Leave a key blank to use the built-in demo provider for that vendor.
# ============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model ids (verify the current ids with each vendor)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-1.5-flash

# openai | anthropic | google | demo
DEFAULT_AI_PROVIDER=demo
AI_TIMEOUT_SECONDS=60
MAX_TOKENS=4096

# ============================================================================
# DEMO MODE
# true  -> EVERY evaluation uses the deterministic demo provider, even if keys are set.
# false -> real providers are used when their key is set; otherwise the request
#          falls back to demo and records the reason (ai_config.fallback_reason).
# ============================================================================
DEMO_MODE=false
DEMO_LATENCY_MS=350

# ============================================================================
# SECURITY SCANNERS
# The built-in rule scanner always runs. Bandit adds Python-specific checks.
# ============================================================================
BANDIT_ENABLED=true
SCANNER_TIMEOUT_SECONDS=30

# ============================================================================
# REFLEXION
# Default number of repair rounds (clamped to 1..10)
# ============================================================================
DEFAULT_REFLEXION_ROUNDS=3

# ============================================================================
# LIMITS
# ============================================================================
MAX_CODE_CHARS=50000
MAX_TASK_CHARS=5000

# ============================================================================
# CORS (comma-separated browser origins allowed to call the API directly)
# The Next.js frontend proxies /api server-side, so it does not need CORS.
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# true -> also allow Origin "null" (sent by pages opened from file:// and by sandboxed iframes).
# Sandboxed iframes on any website can send it, so keep this false unless you need it.
ALLOW_NULL_ORIGIN=false

# Frontend: set BACKEND_URL (in frontend/.env.local or the shell) BEFORE `npm run build`;
# default http://127.0.0.1:8000. See frontend/.env.local.example.
