# SecureReflex AI - frontend environment
# Copy to .env.local (or export in the shell) before `npm run dev` / `npm run build`.
# The browser calls same-origin /api/*; Next.js proxies it to BACKEND_URL.
# Use 127.0.0.1 (not localhost): Node 24 resolves localhost to ::1 first.
BACKEND_URL=http://127.0.0.1:8000
